rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reglas para la colección 'albums' (Lectura y escritura para todos los usuarios autenticados)
    match /albums/{albumId} {
      allow read, write: if request.auth != null;
    }
    
    // Reglas para la colección 'tickets' (Lectura y escritura para todos los usuarios autenticados)
    match /tickets/{ticketId} {
      allow read, write: if request.auth != null;
    }

    // Reglas para la colección 'user_profiles' (Registro global de usuarios para el panel de administración)
    match /user_profiles/{userId} {
      allow read, write: if request.auth != null;
    }
    
    // Regla de respaldo global
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
